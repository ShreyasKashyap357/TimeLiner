{
  "name": "timeliner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive static explorer for fictional franchise timelines (unofficial).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch:sources": "tsx scripts/fetch/run.ts",
    "build:candidates": "tsx scripts/build/run.ts",
    "verify": "tsx scripts/verify-data.ts",
    "verify:remote": "tsx scripts/verify-data.ts --refetch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.81.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
